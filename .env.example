# Copy this file to .env and fill in the values you need.
# backend/config/settings.py loads .env automatically (via os.environ.setdefault,
# so real environment variables always take precedence over this file).

# --- Django -----------------------------------------------------------------
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG=0. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Comma-separated. Add your domain/IP when deploying beyond localhost.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000
DJANGO_TIME_ZONE=UTC

# Require login/Bearer-token auth on the legacy /api/* surface.
# Defaults to "not DEBUG" if unset; set explicitly once you go to production.
DASHBOARD_AUTH_REQUIRED=1
# Optional shared-secret Bearer token for trusted internal callers of /api/*.
DASHBOARD_INTERNAL_API_TOKEN=
DASHBOARD_OWNER_USERNAME=owner

# --- Database ----------------------------------------------------------------
# "sqlite" (default, zero setup) or "mysql" (see db/script.sh + db/README-equivalent
# instructions in the main README for running MySQL via Docker Compose).
DJANGO_DB_ENGINE=sqlite
# DJANGO_DB_NAME=slack_dashboard
# DJANGO_DB_USER=slack_dashboard
# DJANGO_DB_PASSWORD=replace-with-db-password
# DJANGO_DB_HOST=127.0.0.1
# DJANGO_DB_PORT=13307

# --- Slack ingestion -----------------------------------------------------------
# Bot token from your Slack app (Bot Token Scopes: channels:history;
# add groups:history too if any source channel is private). Invite the bot to
# every channel listed below.
SLACK_BOT_TOKEN=
# Comma-separated channel IDs to import as knowledge sources.
SLACK_KNOWLEDGE_CHANNELS=
# Optional: a channel containing questions that @-mention the bot. The sync
# imports those threads and any existing bot replies as their own knowledge
# type; this application does not post an answer. Leave blank to disable.
SLACK_DASHBOARD_FREE_QUESTION_CHANNEL=
# Optional: restrict who can ask (Slack user ID). Leave blank to allow anyone.
SLACK_DASHBOARD_FREE_QUESTION_USER=
# Only import free-question messages newer than this Slack timestamp (default: all).
SLACK_DASHBOARD_FREE_QUESTION_START_TS=0
# Optional: a channel to sync into the Schedule/TODO view (see README for the
# expected message format).
SLACK_DASHBOARD_SCHEDULE_CHANNEL=
# Optional: your workspace URL (e.g. https://your-team.slack.com), used to
# build "open in Slack" links.
SLACK_DASHBOARD_WORKSPACE_URL=

# --- LLM (classification, tagging, quiz generation) ---------------------------
# "anthropic" (default) or "openai".
LLM_PROVIDER=anthropic
# Required for openai; anthropic defaults to claude-sonnet-5 if left blank.
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=180
